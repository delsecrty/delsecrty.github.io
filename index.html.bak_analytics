dc-script=\"\" data-props=\"{&quot;lang&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;es&quot;,&quot;en&quot;],&quot;default&quot;:&quot;es&quot;,&quot;tsType&quot;:&quot;'es' | 'en'&quot;,&quot;section&quot;:&quot;Contenido&quot;},&quot;heroOverlay&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;min&quot;:0.1,&quot;max&quot;:0.9,&quot;step&quot;:0.05,&quot;default&quot;:0.5,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Hero&quot;}}\">\nclass Component extends DCLogic {\n  state = {\n    lang: null,\n    scrolled: false,\n    formSent: false,\n    menuOpen: false,\n    isMobile: false,\n    aiOpenCat: 0\n  };\n\n  componentDidMount() {\n    try {\n      const saved = localStorage.getItem('delsec-lang');\n      if (saved === 'en') this.setState({ lang: 'en' });\n    } catch (e) {}\n\n    this._onScroll = () => {\n      const sc = window.scrollY > 40;\n      if (sc !== this.state.scrolled) this.setState({ scrolled: sc });\n    };\n    window.addEventListener('scroll', this._onScroll, { passive: true });\n\n    this._mq = window.matchMedia('(max-width: 1180px)');\n    this._onMq = () => this.setState({ isMobile: this._mq.matches, menuOpen: false });\n    this._mq.addEventListener('change', this._onMq);\n    if (this._mq.matches) this.setState({ isMobile: true });\n\n    // Reveal on scroll + counters\n    setTimeout(() => this._initReveals(), 100);\n  }\n\n  componentWillUnmount() {\n    window.removeEventListener('scroll', this._onScroll);\n    if (this._mq) this._mq.removeEventListener('change', this._onMq);\n    if (this._obs) this._obs.disconnect();\n    if (this._cObs) this._cObs.disconnect();\n  }\n\n  _initReveals() {\n    const els = document.querySelectorAll('[data-reveal]');\n    this._obs = new IntersectionObserver((entries) => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting) {\n          entry.target.style.opacity = '1';\n          entry.target.style.transform = 'translate(0, 0)';\n          this._obs.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });\n\n    els.forEach(el => {\n      const dir = el.getAttribute('data-reveal');\n      const rect = el.getBoundingClientRect();\n      if (rect.top < window.innerHeight) return; // already visible, don't hide\n      el.style.opacity = '0';\n      el.style.transform = dir === 'left' ? 'translateX(-50px)' : dir === 'right' ? 'translateX(50px)' : 'translateY(40px)';\n      el.style.transition = 'opacity 0.7s ease, transform 0.7s ease';\n      this._obs.observe(el);\n    });\n\n    // Counters\n    const counters = document.querySelectorAll('[data-count]');\n    this._cObs = new IntersectionObserver((entries) => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting) {\n          this._animateCounter(entry.target);\n          this._cObs.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.5 });\n    counters.forEach(el => this._cObs.observe(el));\n  }\n\n  _animateCounter(el) {\n    const raw = el.getAttribute('data-count') || '';\n    if (!/^\\d+$/.test(raw)) return; // non-numeric values (e.g. \"24/7\") stay static\n    const target = parseInt(raw, 10);\n    const prefix = el.getAttribute('data-prefix') || '';\n    if (!target) return;\n    const duration = 1800;\n    const start = performance.now();\n    const step = (now) => {\n      const p = Math.min((now - start) / duration, 1);\n      const eased = 1 - Math.pow(1 - p, 3);\n      el.textContent = prefix + Math.floor(eased * target);\n      if (p < 1) requestAnimationFrame(step);\n      else el.textContent = prefix + target;\n    };\n    requestAnimationFrame(step);\n  }\n\n  _setLang(lang) {\n    this.setState({ lang });\n    try { localStorage.setItem('delsec-lang', lang); } catch (e) {}\n  }\n\n  _translations() {\n    return {\n      es: {\n        nav0: 'Nosotros', nav1: 'Servicios', nav2: 'Por qué elegirnos', nav3: 'Contacto', navIa: 'IA', navPymes: 'IA a tu esc